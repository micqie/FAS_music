# Local development: keep using MySQL.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=music_db
DB_USER=root
DB_PASSWORD=

# For Render PostgreSQL, set DB_DRIVER=pgsql and DATABASE_URL to the Internal
# Database URL. For external URLs use the provider's required SSL mode.
# For local PostgreSQL with individual DB_* fields, set DB_SSLMODE=disable.
DB_SSLMODE=

# SMTP settings (set real values as environment variables; never commit secrets).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Father & Sons Music School
MAIL_REPLY_TO=
MAIL_VERIFY_PEER=true
